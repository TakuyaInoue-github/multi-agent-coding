{                                                                                                          "$schema": "https://json.schemastore.org/claude-code-settings.json",
                                                                                                           "permissions": {
                                                                                                               "defaultMode": "dontAsk",
                                                                                                               "allow": [
                                                                                                                   "Read(**)",
                                                                                                                   "Bash(bash -n *)",
                                                                                                                   "Bash(bash .multi-agent/scripts/*)"
                                                                                                               ],
                                                                                                               "deny": [
                                                                                                                   "Edit(./.claude/settings.json)",
                                                                                                                   "Write(./.claude/settings.json)"
                                                                                                               ]
                                                                                                           },
                                                                                                           "hooks": {
                                                                                                               "PreToolUse": [
                                                                                                                   {
                                                                                                                       "matcher": "Bash",
                                                                                                                       "hooks": [{"type": "command", "command":
                                                                                                                                  "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/validate-bash.sh"}]
                                                                                                                   },
                                                                                                                   {
                                                                                                                       "matcher": "Edit|Write",
                                                                                                                       "hooks": [{"type": "command", "command":
                                                                                                                                  "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-files.sh"}]
                                                                                                                   }
                                                                                                               ],
                                                                                                               "PostToolUse": [
                                                                                                                   {
                                                                                                                       "matcher": "Bash|Edit|Write",
                                                                                                                       "hooks": [{"type": "command", "command":
                                                                                                                                  "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/log-activity.sh"}]
                                                                                                                   }
                                                                                                               ]
                                                                                                           }
}
