{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit -m *)",
      "Bash(git checkout -b *)",
      "Bash(git checkout main)",
      "Bash(git checkout develop)",
      "Bash(git branch *)",
      "Bash(git stash *)",
      "Bash(git merge --no-ff *)",
      "Bash(mkdir *)",
      "Bash(node *)",
      "Skill(status-sync)",
      "Skill(gate-evaluation)",
      "Skill(start-task)",
      "Skill(task-decomposition)",
      "Skill(codex:rescue)",
      "Skill(codex:setup)",
      "Skill(codex:codex-cli-runtime)",
      "Skill(codex:codex-result-handling)",
      "Skill(codex:gpt-5-4-prompting)",
      "SlashCommand(/codex:rescue:*)",
      "SlashCommand(/codex:status:*)",
      "SlashCommand(/codex:setup:*)",
      "SlashCommand(/codex:cancel:*)",
      "SlashCommand(/codex:review:*)",
      "SlashCommand(/codex:result:*)",
      "SlashCommand(/codex:adversarial-review:*)"
    ],
    "ask": [
      "Bash(npm install *)",
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(git push *)",
      "Bash(git merge *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "Bash(rm -rf *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(kubectl *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(aws *)",
      "Bash(gcloud *)",
      "Bash(az *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./secrets/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/validate-bash.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-files.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/log-activity.sh"
          }
        ]
      }
    ]
  }
}
